# Language statistics only. Nothing here changes how anything builds or runs.
#
# The editor extension and the Python worker are LiveScript now, compiled in the
# browser, so the JavaScript left in this repository is two small boot shims and
# the browser test. Nothing is hidden from the count any more: what remains
# marked below is genuinely vendored or genuinely generated.

# The LiveScript compiler, bundled from the npm package and committed so a
# classroom with no internet can still compile the editor extension.
web/runtime/livescript.js       linguist-vendored=true

# Bundles, built from npm packages and committed so a classroom with no internet
# still gets a Java syntax checker and a formatter.
web/runtime/java-format.js      linguist-generated=true
web/runtime/java-parser.js      linguist-generated=true

# The trimmed VS Code workbench: 39 MB of someone else's JavaScript.
vendor/**                       linguist-vendored=true

# Keep the sample assignments byte-for-byte; they are zips, not text to merge.
examples/*.zip                  binary
